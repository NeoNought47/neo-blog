---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";
import { SITE } from "../consts";

const posts = await getPosts();
const [featured, ...rest] = posts;
---

<Base>
  <section class="hero page">
    <span class="hero__eyebrow">{posts.length} 篇记录</span>
    <h1 class="hero__title" set:html={SITE.heroTitle} />
    <address class="hero__shop">
      <span>{SITE.shop.address}</span>
      <span>{SITE.shop.phone}</span>
      <span class="hero__hours">{SITE.shop.hours}</span>
    </address>
  </section>

  <div class="page">
    <div class="section-head">
      <h2>最新</h2>
      <a href="/archive">查看全部 →</a>
    </div>

    <div class="grid">
      {featured && <PostCard post={featured} />}
      {rest.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>
