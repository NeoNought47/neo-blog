---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, readingTime } from "../../lib/posts";
import { UI, fill, formatDateBoth } from "../../i18n";
import T from "../../components/T.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // 列表按时间倒序，所以「上一篇」= 更新的那篇 = 索引更小
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, titleEn, date, tags, cover, description, draft } = post.data;
const d = formatDateBoth(date);
const mins = readingTime(post.body ?? "");
---

<Base title={title} description={description ?? title} progress>
  <article>
    <header class="post-head page">
      <div class="tag-row" style="justify-content:center">
        {tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>{t}</a>)}
      </div>
      <h1><T zh={title} en={titleEn ?? title} /></h1>
      <div class="post-head__meta">
        <time datetime={date.toISOString()}><T zh={d.zh} en={d.en} /></time>
        <span class="dot"></span>
        <T zh={fill(UI.post.readingTime.zh, { n: mins })} en={fill(UI.post.readingTime.en, { n: mins })} />
        {draft && (<><span class="dot"></span><span style="color:var(--accent-2)"><T zh={UI.post.draft.zh} en={UI.post.draft.en} /></span></>)}
      </div>
    </header>

    {
      cover && (
        <div class="post-cover">
          <Image src={cover} alt={title} width={2000} loading="eager" />
        </div>
      )
    }

    <div class="prose page">
      <Content />
    </div>

    <nav class="pager page" aria-label="文章导航">
      {
        newer ? (
          <a class="pager__item" href={`/posts/${newer.id}`}>
            <div class="pager__label"><T zh={UI.post.prev.zh} en={UI.post.prev.en} /></div>
            <div class="pager__title"><T zh={newer.data.title} en={newer.data.titleEn ?? newer.data.title} /></div>
          </a>
        ) : (
          <span />
        )
      }
      {
        older && (
          <a class="pager__item pager__item--next" href={`/posts/${older.id}`}>
            <div class="pager__label"><T zh={UI.post.next.zh} en={UI.post.next.en} /></div>
            <div class="pager__title"><T zh={older.data.title} en={older.data.titleEn ?? older.data.title} /></div>
          </a>
        )
      }
    </nav>
  </article>
</Base>
