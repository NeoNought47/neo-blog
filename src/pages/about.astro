---
import Base from "../layouts/Base.astro";
import { UI } from "../i18n";
import T from "../components/T.astro";
---

<Base title="关于" description="关于这个博客和我">
  <section class="hero page" style="padding-bottom:1rem">
    <span class="hero__eyebrow">About</span>
    <h1 class="hero__title"><T zh={UI.about.title.zh} en={UI.about.title.en} /></h1>
  </section>

  <div class="prose narrow" style="padding-bottom:3rem">
    <T as="p" zh={UI.about.founded.zh} en={UI.about.founded.en} />
    <h2><T zh={UI.about.aboutSiteHeading.zh} en={UI.about.aboutSiteHeading.en} /></h2>
    <T as="p" zh={UI.about.aboutSite.zh} en={UI.about.aboutSite.en} />
  </div>
</Base>
