---
import { SITE } from "../consts";
import { UI } from "../i18n";
import T from "../components/T.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** 文章页开启顶部阅读进度条 */
  progress?: boolean;
}

const { title, description = SITE.description, progress = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    {/* 在首屏渲染前定好主题，避免暗色模式下白屏闪一下。
        奶油色是设计基调，深色只是备选。 */}
    <script is:inline>
      // 奶油色是这个站的主态，只有手动切过才用深色
      if (localStorage.getItem("theme") !== "dark") {
        document.documentElement.dataset.theme = "light";
      }
      // 代码块深浅：用户手动选过就听用户的，否则跟随站点主题
      (() => {
        const root = document.documentElement;
        const pref = localStorage.getItem("codeTheme");
        const dark = pref ? pref === "dark" : root.dataset.theme !== "light";
        root.classList.add(dark ? "code-dark" : "code-light");
      })();
      // 界面语言：默认中文，只有手动切过才用英文
      if (localStorage.getItem("uiLang") === "en") {
        document.documentElement.dataset.uiLang = "en";
        document.documentElement.lang = "en";
      }
      // 标记 JS 可用，入场动画只在这个前提下启用
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <div class="aurora" aria-hidden="true"><span class="aurora__green"></span></div>
    <div class="grain" aria-hidden="true"></div>
    {progress && <div class="progress" id="progress" aria-hidden="true"></div>}

    <header class="nav" id="nav">
      <nav class="nav__inner page" aria-label="主导航">
        <a class="nav__brand" href="/" set:html={SITE.brand} />
        {
          SITE.nav.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={
                item.href === "/"
                  ? path === "/"
                    ? "page"
                    : undefined
                  : path.startsWith(item.href)
                    ? "page"
                    : undefined
              }
            >
              <T zh={item.label} en={item.labelEn} />
            </a>
          ))
        }
        <button class="lang-btn" id="lang-btn" type="button" aria-label="Language / 语言">
          <span class="lang-btn__opt" data-opt="zh">中</span>
          <span class="lang-btn__sep" aria-hidden="true"></span>
          <span class="lang-btn__opt" data-opt="en">EN</span>
        </button>
        <button class="theme-btn" id="theme-btn" type="button" aria-label="切换明暗主题">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer page">
      <div class="footer__shop">
        <span class="footer__name">{SITE.title}</span>
        <address>
          {SITE.shop.address}<span class="dot"></span>{SITE.shop.phone}
        </address>
        <span class="footer__hours"><T zh={UI.home.hours.zh} en={UI.home.hours.en} /></span>
      </div>
      <div class="footer__meta">
        <span>© {SITE.startYear}–{new Date().getFullYear()} {SITE.author}</span>
        <span>
          <a href="/rss.xml">RSS</a> · <T zh={UI.footer.poweredBy.zh} en={UI.footer.poweredBy.en} />
        </span>
      </div>
    </footer>

    {/* 首次切到英文时弹一次，说明翻译覆盖范围 */}
    <div class="en-notice" id="en-notice" role="dialog" aria-modal="true" aria-label="Language note">
      <div class="en-notice__card">
        <p set:html={UI.enNotice.body} />
        <button type="button" class="en-notice__ok" id="en-notice-ok">{UI.enNotice.dismiss}</button>
      </div>
    </div>

    {/* 图片灯箱容器，由 script 填充 */}
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片预览">
      <button class="lightbox__close" type="button" aria-label="关闭">✕</button>
      <img alt="" />
    </div>

    <script>
      // ---- 明暗主题 ----
      const btn = document.getElementById("theme-btn");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const light = root.dataset.theme === "light";
        if (light) delete root.dataset.theme;
        else root.dataset.theme = "light";
        localStorage.setItem("theme", light ? "dark" : "light");
        // 用户没单独指定过代码块深浅时，让它跟着站点主题走
        if (!localStorage.getItem("codeTheme")) {
          root.classList.toggle("code-dark", light);
          root.classList.toggle("code-light", !light);
        }
      });

      // ---- 界面语言切换 ----
      const langBtn = document.getElementById("lang-btn");
      // 第一次来的人不知道这里能点，给个呼吸光圈，看过就不再提示
      if (langBtn && !localStorage.getItem("langHintSeen")) {
        langBtn.classList.add("hint");
        setTimeout(() => langBtn.classList.remove("hint"), 6000);
      }
      langBtn?.addEventListener("click", () => {
        const root = document.documentElement;
        langBtn.classList.remove("hint");
        localStorage.setItem("langHintSeen", "1");
        const toEn = root.dataset.uiLang !== "en";
        if (toEn) {
          root.dataset.uiLang = "en";
          root.lang = "en";
        } else {
          delete root.dataset.uiLang;
          root.lang = "zh-CN";
        }
        localStorage.setItem("uiLang", toEn ? "en" : "zh");

        // 每次切到英文都说明一下翻译覆盖到什么程度
        if (toEn) {
          notice?.classList.add("open");
          document.body.style.overflow = "hidden";
        }
      });

      const notice = document.getElementById("en-notice");
      const closeNotice = () => {
        notice?.classList.remove("open");
        document.body.style.overflow = "";
      };
      document.getElementById("en-notice-ok")?.addEventListener("click", closeNotice);
      notice?.addEventListener("click", (e) => {
        if (e.target === notice) closeNotice();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && notice?.classList.contains("open")) closeNotice();
      });

      // ---- 导航栏滚动出分隔线 ----
      const nav = document.getElementById("nav");
      const progress = document.getElementById("progress");
      const onScroll = () => {
        nav?.classList.toggle("scrolled", window.scrollY > 8);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? window.scrollY / max : 0;
          progress.style.transform = `scaleX(${Math.min(1, Math.max(0, pct))})`;
        }
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // ---- 滚动入场动画 ----
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i, 8) * 55}ms`;
        io.observe(el);
      });

      // ---- 代码块深浅切换 ----
      const ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
        '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>';
      document.querySelectorAll<HTMLElement>(".prose pre").forEach((pre) => {
        // 按钮不能直接放进 <pre>，否则复制代码时会把它一起带走
        const wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const b = document.createElement("button");
        b.type = "button";
        b.className = "code-toggle";
        b.title = "切换代码块深浅";
        b.setAttribute("aria-label", "切换代码块深浅");
        b.innerHTML = ICON;
        b.addEventListener("click", () => {
          const root = document.documentElement;
          const toDark = root.classList.contains("code-light");
          root.classList.toggle("code-dark", toDark);
          root.classList.toggle("code-light", !toDark);
          localStorage.setItem("codeTheme", toDark ? "dark" : "light");
        });
        wrap.appendChild(b);
      });

      // ---- 正文图片：绝不放大显示 ----
      // 屏幕是几倍屏，一张图就得有几倍的像素才不算放大。
      // CSS 读不到图片的真实像素数，只能在这里按 naturalWidth / DPR 封顶。
      const capImage = (img: HTMLImageElement) => {
        if (!img.naturalWidth) return;
        const maxCss = img.naturalWidth / (window.devicePixelRatio || 1);
        img.style.maxWidth = `min(100%, ${Math.floor(maxCss)}px)`;
      };
      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
        if (img.complete) capImage(img);
        else img.addEventListener("load", () => capImage(img), { once: true });
      });

      // ---- 正文图片灯箱 ----
      const lb = document.getElementById("lightbox");
      const lbImg = lb?.querySelector("img") as HTMLImageElement | null;
      const close = () => {
        lb?.classList.remove("open");
        document.body.style.overflow = "";
      };
      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
        img.addEventListener("click", () => {
          if (!lb || !lbImg) return;
          // 用 currentSrc 拿到浏览器实际选中的那档尺寸
          lbImg.src = img.currentSrc || img.src;
          lbImg.alt = img.alt;
          lb.classList.add("open");
          document.body.style.overflow = "hidden";
        });
      });
      lb?.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    </script>
  </body>
</html>
