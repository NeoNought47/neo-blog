---
/**
 * 文章目录（类似 Notion）：右侧一列短横线，悬停展开成标题列表，点击跳转。
 * 目录在浏览器里根据正文的 h2 / h3 / h4 现场生成，
 * 双语文章只列出当前语言里看得见的标题，切换语言时自动重建。
 */
---

<nav class="toc" id="toc" aria-label="目录 / Contents" hidden>
  <div class="toc__rail" aria-hidden="true"></div>
  <div class="toc__panel">
    <ol class="toc__list"></ol>
  </div>
</nav>

<script>
  const toc = document.getElementById("toc");
  const prose = document.querySelector(".prose");
  if (toc && prose) {
    const rail = toc.querySelector<HTMLElement>(".toc__rail")!;
    const list = toc.querySelector<HTMLElement>(".toc__list")!;
    let heads: HTMLElement[] = [];
    let bars: HTMLElement[] = [];
    let items: HTMLElement[] = [];
    let active = -1;

    const visible = (el: HTMLElement) => el.getClientRects().length > 0;

    function build() {
      heads = [...prose!.querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id]")].filter(visible);
      rail.replaceChildren();
      list.replaceChildren();
      bars = [];
      items = [];
      active = -1;
      if (heads.length < 2) {
        toc!.hidden = true;
        return;
      }
      toc!.hidden = false;
      for (const h of heads) {
        const lv = h.tagName.toLowerCase();
        const bar = document.createElement("span");
        bar.className = `toc__bar toc__bar--${lv}`;
        rail.append(bar);
        bars.push(bar);

        const li = document.createElement("li");
        const a = document.createElement("a");
        a.className = `toc__item toc__item--${lv}`;
        a.href = `#${h.id}`;
        a.textContent = h.textContent?.trim() ?? "";
        a.addEventListener("click", (e) => {
          e.preventDefault();
          h.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", `#${h.id}`);
          toc!.classList.remove("open");
        });
        li.append(a);
        list.append(li);
        items.push(a);
      }
      update();
    }

    function update() {
      let idx = 0;
      for (let i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= 130) idx = i;
        else break;
      }
      if (idx === active) return;
      bars[active]?.classList.remove("on");
      items[active]?.classList.remove("on");
      active = idx;
      bars[idx]?.classList.add("on");
      items[idx]?.classList.add("on");
      items[idx]?.scrollIntoView({ block: "nearest" });
    }

    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );

    // 触屏没有悬停：点横线展开，点别处收起
    rail.addEventListener("click", () => toc.classList.toggle("open"));
    document.addEventListener("click", (e) => {
      if (!toc.contains(e.target as Node)) toc.classList.remove("open");
    });

    // 切换语言后，看得见的标题变了，重建目录
    new MutationObserver(() => build()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-ui-lang"],
    });

    build();
  }
</script>

<style is:global>
  .prose :is(h2, h3, h4) {
    scroll-margin-top: 96px;
  }

  .toc {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
  }
  .toc[hidden] {
    display: none;
  }

  .toc__rail {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    padding: 12px 6px;
    cursor: pointer;
    max-height: 70vh;
    overflow: hidden;
  }
  .toc__bar {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--text-faint);
    opacity: 0.55;
    transition: background 0.2s, opacity 0.2s;
  }
  .toc__bar--h2 { width: 16px; }
  .toc__bar--h3 { width: 11px; }
  .toc__bar--h4 { width: 7px; }
  .toc__bar.on {
    background: var(--accent);
    opacity: 1;
  }

  .toc__panel {
    position: absolute;
    right: 0;
    top: 50%;
    width: 280px;
    max-height: 72vh;
    overflow-y: auto;
    padding: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translate(8px, -50%);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
    overscroll-behavior: contain;
  }
  @media (hover: hover) {
    .toc:hover .toc__panel {
      opacity: 1;
      pointer-events: auto;
      transform: translate(0, -50%);
    }
  }
  .toc.open .toc__panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc__item {
    display: block;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--text-muted);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .toc__item--h3 { padding-left: 24px; }
  .toc__item--h4 { padding-left: 38px; font-size: 13px; }
  .toc__item:hover {
    background: var(--accent-soft);
    color: var(--text);
  }
  .toc__item.on {
    color: var(--accent);
    font-weight: 600;
  }

  /* 手机上贴紧屏幕边缘，免得横线压到正文 */
  @media (max-width: 760px) {
    .toc { right: 0; }
    .toc__rail { padding: 12px 4px; gap: 8px; }
    .toc__panel { width: min(280px, calc(100vw - 32px)); right: 8px; }
  }

  @media print {
    .toc { display: none; }
  }
</style>
