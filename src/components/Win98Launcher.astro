---
/**
 * 首页右下角悬浮的「我的电脑」，点进去是 /win98。
 * 图标照 Win98 的样子自己画的：32×32 的像素格，纯色块，没有渐变和阴影。
 * 放大到 64px 显示，一个像素占 2px，边缘保持锯齿感。
 */
import T from "./T.astro";
import { UI } from "../i18n";
---

<a class="launcher" href="/win98" aria-label={UI.win98.title.zh}>
  <svg class="launcher__icon" viewBox="0 0 32 32" aria-hidden="true" shape-rendering="crispEdges">
    {/* 显示器：黑描边、灰机身、左上白高光、右下深灰 */}
    <rect x="7" y="2" width="18" height="18" fill="#000" />
    <rect x="8" y="3" width="16" height="16" fill="#c0c0c0" />
    <rect x="8" y="3" width="15" height="1" fill="#fff" />
    <rect x="8" y="3" width="1" height="15" fill="#fff" />
    <rect x="8" y="18" width="16" height="1" fill="#808080" />
    <rect x="23" y="3" width="1" height="16" fill="#808080" />

    {/* 屏幕：青色，里面开着一个小窗口 */}
    <rect x="10" y="5" width="12" height="11" fill="#404040" />
    <rect x="11" y="6" width="10" height="9" fill="#00a8a8" />
    <rect x="13" y="8" width="6" height="5" fill="#000" />
    <rect x="14" y="9" width="4" height="3" fill="#fff" />
    <rect x="13" y="8" width="6" height="1" fill="#000080" />
    <rect x="20" y="16" width="2" height="1" fill="#00c000" />

    {/* 脖子 */}
    <rect x="12" y="20" width="8" height="2" fill="#000" />
    <rect x="13" y="20" width="6" height="2" fill="#808080" />

    {/* 卧式机箱：绿灯、按钮、软驱口 */}
    <rect x="2" y="22" width="28" height="8" fill="#000" />
    <rect x="3" y="23" width="26" height="6" fill="#c0c0c0" />
    <rect x="3" y="23" width="25" height="1" fill="#fff" />
    <rect x="3" y="23" width="1" height="5" fill="#fff" />
    <rect x="3" y="28" width="26" height="1" fill="#808080" />
    <rect x="28" y="23" width="1" height="6" fill="#808080" />
    <rect x="6" y="25" width="3" height="2" fill="#00e000" />
    <rect x="11" y="25" width="2" height="2" fill="#808080" />
    <rect x="15" y="25" width="11" height="2" fill="#808080" />
    <rect x="16" y="25" width="9" height="1" fill="#000" />
  </svg>

  <span class="launcher__label">
    <T zh={UI.win98.label.zh} en={UI.win98.label.en} />
  </span>
  <span class="launcher__tip" role="tooltip">
    <T zh={UI.win98.title.zh} en={UI.win98.title.en} />
  </span>
</a>
