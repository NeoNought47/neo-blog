---
import { Image } from "astro:assets";
import { type Post } from "../lib/posts";
import { UI, formatDateBoth } from "../i18n";
import T from "../components/T.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, titleEn, date, tags, cover, draft, hasEnglish } = post.data;
const d = formatDateBoth(date);
---

<article class="card reveal">
  {
    cover && (
      <div class="card__media">
        <Image src={cover} alt={title} width={720} height={450} loading="lazy" />
      </div>
    )
  }
  <div class="card__body">
    <h3 class="card__title">
      <a class="card__link" href={`/posts/${post.id}`}>
        <T zh={title} en={titleEn ?? title} />
      </a>
    </h3>
    <div class="tag-row">
      {tags.slice(0, 3).map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>{t}</a>)}
    </div>
    <div class="card__meta">
      {hasEnglish && (
        <>
          <span class="en-badge" title={UI.enBadge.title.en}>{UI.enBadge.label}</span>
          <span class="dot" />
        </>
      )}
      <time datetime={date.toISOString()}><T zh={d.zh} en={d.en} /></time>
      {draft && (<><span class="dot" /><span style="color:var(--accent-2)"><T zh={UI.post.draft.zh} en={UI.post.draft.en} /></span></>)}
    </div>
  </div>
</article>
