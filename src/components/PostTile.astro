---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts";
import { getCover } from "../lib/covers";
import { UI, formatDateBoth } from "../i18n";
import T from "./T.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, titleEn, date, tags, draft, hasEnglish } = post.data;
const cover = await getCover(post);
const d = formatDateBoth(date);
---

<article class="tile reveal">
  <a class="tile__media" href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Image src={cover} alt="" width={560} height={560} loading="lazy" />
      ) : (
        <span class="tile__ph">{tags[0] ?? ""}</span>
      )
    }
  </a>

  <div class="tile__body">
    <h3 class="tile__title">
      <a class="tile__link" href={`/posts/${post.id}`}>
        <T zh={title} en={titleEn ?? title} />
      </a>
    </h3>
    <div class="tile__meta">
      <time datetime={date.toISOString()}><T zh={d.zh} en={d.en} /></time>
      {hasEnglish && (<><span class="dot" /><span class="en-badge" title={UI.enBadge.title.en}>{UI.enBadge.label}</span></>)}
      {draft && (<><span class="dot" /><span style="color:var(--accent-2)"><T zh={UI.post.draft.zh} en={UI.post.draft.en} /></span></>)}
    </div>
  </div>
</article>
