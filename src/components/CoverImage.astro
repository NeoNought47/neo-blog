---
/**
 * 列表里的封面缩略图：整张图都要看得见，不裁。
 *
 * 以前是生成图片时同时给宽高（Astro 默认会裁成这个比例），CSS 再 object-fit: cover，
 * 截图类封面和竖拍的照片两头都被切掉。现在：
 *   - 生成时 fit: "inside"，只在 width × height 的框里等比缩小，不裁
 *   - 前景 object-fit: contain，整张显示
 *   - 留出的空白用同一张图放大、模糊后垫在后面，看着是有意为之而不是白边
 * 前后两层是同一个 URL，浏览器只下载一次。
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  src: ImageMetadata;
  /** 生成图片的最大框，按显示尺寸的两倍给，Retina 上也清楚 */
  width: number;
  height: number;
  alt?: string;
  loading?: "lazy" | "eager";
}

const { src, width, height, alt = "", loading = "lazy" } = Astro.props;
const img = await getImage({ src, width, height, fit: "inside", layout: "none" });
---

<span class="cov">
  <img class="cov__bg" src={img.src} alt="" aria-hidden="true" loading={loading} decoding="async" />
  <img class="cov__fg" src={img.src} alt={alt} loading={loading} decoding="async" />
</span>
