---
import { Image } from "astro:assets";
import { SITE } from "../consts";
import { UI, formatDateBoth } from "../i18n";
import { getCover } from "../lib/covers";
import type { Post } from "../lib/posts";
import T from "./T.astro";

interface Props {
  posts: number;
  tags: number;
  images: number;
  /** 「最近更新」列表 */
  recent: Post[];
}

const { posts, tags, images, recent } = Astro.props;

const recentWithCover = await Promise.all(
  recent.map(async (p) => ({ post: p, cover: await getCover(p) })),
);
---

<aside class="side">
  <div class="side__card">
    <img class="side__avatar" src="/favicon.svg" alt="" width="76" height="76" />
    <div class="side__name" set:html={SITE.brand} />
    <div class="side__tagline" set:html={SITE.heroTitle} />

    <div class="side__stats">
      <a class="side__stat" href="/archive">
        <b>{posts}</b>
        <span><T zh="文章" en="Posts" /></span>
      </a>
      <a class="side__stat" href="/tags">
        <b>{tags}</b>
        <span><T zh="标签" en="Tags" /></span>
      </a>
      <span class="side__stat">
        <b>{images}</b>
        <span><T zh="图片" en="Images" /></span>
      </span>
    </div>
  </div>

  <div class="side__card side__card--flush">
    <span class="side__label"><T zh="最近更新" en="Recent" /></span>
    <ul class="recent">
      {
        recentWithCover.map(({ post, cover }) => {
          const d = formatDateBoth(post.data.date);
          return (
            <li class="recent__item">
              <a class="recent__thumb" href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
                {cover ? (
                  <Image src={cover} alt="" width={160} height={160} loading="lazy" />
                ) : (
                  <span class="recent__ph">{post.data.tags[0] ?? ""}</span>
                )}
              </a>
              <div class="recent__info">
                <a class="recent__title" href={`/posts/${post.id}`}>
                  <T zh={post.data.title} en={post.data.titleEn ?? post.data.title} />
                </a>
                <time class="recent__date" datetime={post.data.date.toISOString()}>
                  <T zh={d.zh} en={d.en} />
                </time>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="side__card side__card--shop">
    <span class="side__label"><T zh="到店" en="Visit" /></span>
    <address>
      <span>{SITE.shop.address}</span>
      <span>{SITE.shop.phone}</span>
    </address>
    <span class="side__hours"><T zh={UI.home.hours.zh} en={UI.home.hours.en} /></span>
  </div>
</aside>
